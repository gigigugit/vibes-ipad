                top: selectorDragState.frame.top + (event.clientY - selectorDragState.startY),
                width: selectorDragState.frame.width,
                height: selectorDragState.frame.height,
                minimized: selectorPanelMinimized,
            });
        }
        if (selectorResizeState) {
