                "onset of symptoms",
                "onset of your symptoms",
            ]
            for anchor in onset_anchors:
                indices = [i for i, l in enumerate(low) if anchor in l]
                for idx in indices:
                    for j in range(idx + 1, min(len(lines), idx + 15)):
                        answer = lines[j].lower().strip()
                        if not answer:
